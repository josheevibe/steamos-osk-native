+/* Use the source device only for keys explicitly remapped by an X11 client.
+ * The master follows compositor keymaps, including temporary text keymaps;
+ * untouched keys must continue to follow its configured keyboard layout.
+ */
+static KeySym
+xwl_xtest_keysym(DeviceIntPtr dev, int detail)
+{
+    XkbDescPtr map = dev->key->clientKeymap[detail]
+        ? dev->key->xkbInfo->desc : dev->master->key->xkbInfo->desc;
+    return XkbKeySym(map, detail, 0);
+}
